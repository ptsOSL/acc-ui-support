				<command>$(phoebus.install)/../phoebus.sh -resource "pv://?$(device):LOG:M2&amp;$(device):LOG:M4&amp;$(device):LOG:M16&amp;$(device):LOG:M18&amp;$(device):LOG:M28&amp;$(device):LOG:M32&amp;$(device):LOG:M44&amp;app=databrowser</command>
			</action>
		</actions>
		<text>Graph</text>
		<x>115</x>
		<y>470</y>
		<width>101</width>
		<height>26</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="14.0"></font>
		</font>
