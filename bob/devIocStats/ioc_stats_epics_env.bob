			<color name="VA title" red="202" green="223" blue="159"></color>
		</background_color>
	</widget>
	<widget type="label" version="2.0.0">
		<name>EDM Label</name>
		<text>EPICS Environment Variables
$(ioc)</text>
		<x>5</x>
		<width>200</width>
		<height>40</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="9.900990099009901"></font>
		</font>
		<foreground_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="VA title" red="202" green="223" blue="159"></color>
		</background_color>
		<vertical_alignment>1</vertical_alignment>
