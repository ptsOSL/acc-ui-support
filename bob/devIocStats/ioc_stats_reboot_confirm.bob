<?xml version="1.0" encoding="utf-8"?>
<display version="2.0.0">
	<name>IOC Reboot Confirmation - $(ioc)</name>
	<x>1785</x>
	<y>206</y>
	<width>240</width>
	<height>136</height>
	<background_color>
		<color name="grey-7" red="145" green="145" blue="145"></color>
	</background_color>
	<grid_step_x>8</grid_step_x>
	<grid_step_y>8</grid_step_y>
	<widget type="rectangle" version="2.0.0">
		<name>EDM Rectangle</name>
		<x>8</x>
		<y>48</y>
		<width>225</width>
		<height>81</height>
		<line_width>1</line_width>
		<line_color>
			<color name="Grey 75%" red="192" green="192" blue="192"></color>
		</line_color>
		<background_color>
			<color name="Grey 75%" red="192" green="192" blue="192"></color>
		</background_color>
	</widget>
	<widget type="rectangle" version="2.0.0">
		<name>EDM Rectangle</name>
		<width>241</width>
		<height>41</height>
		<line_width>1</line_width>
		<line_color>
			<color name="VA title" red="202" green="223" blue="159"></color>
		</line_color>
		<background_color>
			<color name="VA title" red="202" green="223" blue="159"></color>
		</background_color>
	</widget>
	<widget type="label" version="2.0.0">
		<name>EDM Label</name>
		<text>IOC Reboot Confirmation
$(ioc)</text>
		<x>8</x>
		<width>208</width>
		<height>40</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="8.910891089108912"></font>
		</font>
		<foreground_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="VA title" red="202" green="223" blue="159"></color>
		</background_color>
		<vertical_alignment>1</vertical_alignment>
		<border_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</border_color>
	</widget>
	<widget type="action_button" version="3.0.0">
		<name>EDM Exit Button</name>
		<actions>
			<action type="close_display">
				<description>Close display</description>
			</action>
		</actions>
		<text>Exit</text>
		<x>184</x>
		<y>8</y>
		<width>49</width>
		<height>25</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="8.910891089108912"></font>
		</font>
		<foreground_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="Grey 75%" red="192" green="192" blue="192"></color>
		</background_color>
		<tooltip>$(actions)</tooltip>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
	<widget type="label" version="2.0.0">
		<name>EDM Label</name>
		<text>Are you sure you want to
reboot $(ioc)?</text>
		<x>8</x>
		<y>48</y>
		<width>224</width>
		<height>48</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="8.910891089108912"></font>
		</font>
		<foreground_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="White" red="255" green="255" blue="255"></color>
		</background_color>
		<horizontal_alignment>1</horizontal_alignment>
		<vertical_alignment>1</vertical_alignment>
		<border_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</border_color>
	</widget>
	<widget type="action_button" version="2.0.0">
		<name>EDM Message Button</name>
		<x>24</x>
		<y>96</y>
		<width>89</width>
		<height>25</height>
		<off_label>Reboot Now!</off_label>
		<off_color>
			<color name="Button_Background" red="210" green="210" blue="210"></color>
		</off_color>
		<on_label>Reboot Now!</on_label>
		<on_color>
			<color red="168" green="168" blue="168"></color>
		</on_color>
		<show_led>false</show_led>
		<font>
			<font family="liberation sans" style="REGULAR" size="8.910891089108912"></font>
		</font>
		<foreground_color>
			<color name="Black" red="0" green="0" blue="0"></color>
		</foreground_color>
		<actions execute_as_one="true">
			<action type="write_pv">
				<description>Write PV</description>
				<pv_name>$(ioc):SYSRESET</pv_name>
				<value>1</value>
			</action>
			<action type="write_pv">
				<description>Write PV</description>
				<pv_name>$(ioc):SYSRESET</pv_name>
				<value>0</value>
			</action>
		</actions>
		<rules>
			<rule name="OnOffBackgroundRule" prop_id="background_color" out_exp="false">
				<exp bool_exp="widget.getValue() == 1">
					<value>
						<color name="Button: On" red="190" green="190" blue="190"></color>
					</value>
				</exp>
				<exp bool_exp="true">
					<value>
						<color name="Button: On" red="190" green="190" blue="190"></color>
					</value>
				</exp>
				<pv_name>$(ioc):SYSRESET</pv_name>
			</rule>
		</rules>
		<border_alarm_sensitive>false</border_alarm_sensitive>
		<mode>1</mode>
		<text>Reboot Now!</text>
	</widget>
	<widget type="action_button" version="3.0.0">
		<name>EDM Exit Button</name>
		<actions>
			<action type="close_display">
				<description>Close display</description>
			</action>
		</actions>
		<text>Cancel</text>
		<x>128</x>
		<y>96</y>
		<width>89</width>
		<height>25</height>
		<font>
			<font family="liberation sans" style="REGULAR" size="8.910891089108912"></font>
		</font>
		<foreground_color>
			<color name="Text: FG" red="0" green="0" blue="0"></color>
		</foreground_color>
		<background_color>
			<color name="Grey 75%" red="192" green="192" blue="192"></color>
		</background_color>
		<tooltip>$(actions)</tooltip>
		<border_alarm_sensitive>false</border_alarm_sensitive>
	</widget>
</display>